    "/courseapi/v3/multi-search/get-course-list": {
      "get": {
        "operationId": "modern_search",
        "summary": "tenant, title, order, page, per_page=40；可选 term / struc_ids[]；tenant-id 请求头",
        "description": "data.list / total；list 行含 id / title / realname / term_name / kkxy_name\n\n参考客户端消费或构造的字段；不是服务器完整 schema，示例为合成数据",
        "tags": [
          "modern"
        ],
        "parameters": [
          {
            "name": "tenant",
            "in": "query",
            "required": true,
            "description": "当前用户 tenant_id；21 是北理工观察值",
            "schema": {
              "type": "string"
            },
            "example": "21"
          },
          {
            "name": "title",
            "in": "query",
            "required": false,
            "description": "课程或教师关键词，空值表示未按关键词收窄",
            "schema": {
              "type": "string"
            },
            "example": "示例课程"
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "已见排序包括 c.created_at desc / asc 与 c.click_record_num desc",
            "schema": {
              "type": "string"
            },
            "example": "c.created_at desc"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "页码，示例从 1 开始",
            "schema": {
              "type": "integer"
            },
            "example": 1
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "请求页大小，非已验证的平台最大值",
            "schema": {
              "type": "integer"
            },
            "example": 40
          },
          {
            "name": "term",
            "in": "query",
            "required": false,
            "description": "学期列表中查得的编号",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "struc_ids[]",
            "in": "query",
            "required": false,
            "description": "院系树中查得的编号；参考客户端一次传一个",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tenant-id",
            "in": "header",
            "required": true,
            "description": "当前租户",
            "schema": {
              "type": "string"
            },
            "example": "21"
          }
        ],
        "responses": {
          "200": {
            "description": "data.list / total；list 行含 id / title / realname / term_name / kkxy_name",
            "content": {
              "application/json": {
                "schema": {},
                "examples": {
                  "synthetic": {
                    "summary": "合成结构示例，不是真实抓包",
                    "value": {
                      "code": 0,
                      "data": {
                        "list": [
                          {
                            "id": 10001,
                            "title": "示例课程",
                            "realname": "示例教师",
                            "term_name": "2026-2027-1",
                            "kkxy_name": "示例学院"
                          }
