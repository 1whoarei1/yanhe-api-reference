    "/api/search": {
      "get": {
        "operationId": "autoslides_search",
        "summary": "q；课程名 / 教师需 term，课程 ID / 教务编号可不指定",
        "description": "query/total/truncated/results；最多 200 门，无服务端分页；sessionCount 不是视频数量\n\n索引尚未完整；403 HTML 不是空结果；本环境未通过线上读取验收。详见 docs/autoslides.md。",
        "tags": [
          "autoslides"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "查询课程；不接受 session URL",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 64
            }
          },
          {
            "name": "term",
            "in": "query",
            "required": false,
            "description": "名称或教师搜索必需，恰好一个已索引学期",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "query/total/truncated/results；最多 200 门，无服务端分页；sessionCount 不是视频数量",
            "content": {
              "application/json": {
                "schema": {},
                "examples": {
                  "synthetic": {
                    "summary": "合成结构示例，不是真实抓包",
                    "value": {
                      "query": {
                        "q": "示例课程",
                        "term": "2026-2027-1"
                      },
                      "total": 1,
                      "truncated": false,
                      "results": [
                        {
                          "id": 10001,
                          "name": "示例课程",
                          "number": null,
                          "term": "2026-2027-1",
                          "teachers": [
                            "示例教师"
                          ],
                          "sessionCount": 2,
                          "match": {
                            "fields": [
                              "name"
                            ]
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "未完整枚举的 HTTP / 业务错误、登录页或资源不可用；按正文处理，不自动重试写请求。"
          }
        },
        "x-effect": "read",
