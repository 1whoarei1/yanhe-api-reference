    "/lib/ajax/service.php": {
      "post": {
        "operationId": "lexue_courses",
        "summary": "query：sesskey / info；JSON RPC：core_course_get_enrolled_courses_by_timeline_classification",
        "description": "[0].data.courses / nextoffset；此 POST 是课程读取\n\n参考客户端消费或构造的字段；不是服务器完整 schema，示例为合成数据",
        "tags": [
          "lexue"
        ],
        "parameters": [
          {
            "name": "sesskey",
            "in": "query",
            "required": true,
            "description": "当前 M.cfg.sesskey；不保存为公开 API key",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "info",
            "in": "query",
            "required": false,
            "description": "RPC 方法标识",
            "schema": {
              "type": "string"
            },
            "example": "core_course_get_enrolled_courses_by_timeline_classification"
          }
        ],
        "responses": {
          "200": {
            "description": "[0].data.courses / nextoffset；此 POST 是课程读取",
            "content": {
              "application/json": {
                "schema": {},
                "examples": {
                  "synthetic": {
                    "summary": "合成结构示例，不是真实抓包",
                    "value": [
                      {
                        "error": false,
                        "data": {
                          "courses": [
                            {
                              "id": 10001,
                              "fullname": "示例课程",
                              "visible": true
                            }
                          ],
                          "nextoffset": 1
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "default": {
            "description": "未完整枚举的 HTTP / 业务错误、登录页或资源不可用；按正文处理，不自动重试写请求。"
          }
        },
        "x-effect": "read",
        "x-evidence": {
          "repository": "https://github.com/1whoarei1/yanhe-refine",
          "revision": "8a292f47d7f25a697d01c9bd7c69189ce2edbf5a",
          "file": "src/lexue-reader.js",
          "anchor": "/lib/ajax/service.php?",
          "level": "source"
        },
        "x-response-fields": "[0].data.courses / nextoffset；此 POST 是课程读取",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "example": [
                {
                  "index": 0,
                  "methodname": "core_course_get_enrolled_courses_by_timeline_classification",
                  "args": {
                    "classification": "all",
                    "limit": 100,
                    "offset": 0,
                    "sort": "fullname"
                  }
                }
              ]
            }
          }
        }
      }
    },
