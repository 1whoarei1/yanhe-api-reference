    "/mod/{module}/view.php": {
      "get": {
        "operationId": "lexue_module",
        "summary": "id：课程页中实际出现的 module 编号；支持类型见正文",
        "description": "HTML，或 resource 模块的文件重定向；首次探测资源使用 Range: bytes=0-0\n\nmodule 占位只描述已观察模块族；URL 活动仅保留入口，不保证抓取外部目标。\n\n参考客户端消费或构造的字段；不是服务器完整 schema，示例为合成数据",
        "tags": [
          "lexue"
        ],
        "parameters": [
          {
            "name": "module",
            "in": "path",
            "required": true,
            "description": "所属系统返回的标识，避免跨平台或跨实体混用。",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "课程页中实际出现的 module ID",
            "schema": {
              "type": "string"
            },
            "example": "30001"
          }
        ],
        "responses": {
          "200": {
            "description": "HTML，或 resource 模块的文件重定向；首次探测资源使用 Range: bytes=0-0",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              },
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "default": {
            "description": "未完整枚举的 HTTP / 业务错误、登录页或资源不可用；按正文处理，不自动重试写请求。"
          }
        },
        "x-effect": "read",
        "x-evidence": {
          "repository": "https://github.com/1whoarei1/yanhe-refine",
          "revision": "8a292f47d7f25a697d01c9bd7c69189ce2edbf5a",
          "file": "src/lexue-core.js",
          "anchor": "/mod/${type}/view.php",
          "level": "source"
        },
        "x-response-fields": "HTML，或 resource 模块的文件重定向；首次探测资源使用 Range: bytes=0-0"
      }
    },
    "/pluginfile.php/{contextId}/{filePath}": {
      "get": {
        "operationId": "lexue_file",
        "summary": "只能使用页面真实附件链接；forcedownload=1",
        "description": "文件；由浏览器下载 API 接收，不拼接猜测文件路径\n\nfilePath 包含多个路径段，仅作路径族展示；使用真实完整链接，避免代码生成器错误编码斜杠。\n\n参考客户端消费或构造的字段；不是服务器完整 schema，示例为合成数据",
        "tags": [
          "lexue"
        ],
        "parameters": [
          {
            "name": "contextId",
            "in": "path",
            "required": true,
            "description": "所属系统返回的标识，避免跨平台或跨实体混用。",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filePath",
            "in": "path",
            "required": true,
            "description": "真实附件路径后缀，可能含多个路径段；直接使用平台返回的完整链接。",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "forcedownload",
            "in": "query",
            "required": false,
            "description": "参考下载链接显式使用 1",
            "schema": {
              "type": "integer"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "文件；由浏览器下载 API 接收，不拼接猜测文件路径",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "default": {
            "description": "未完整枚举的 HTTP / 业务错误、登录页或资源不可用；按正文处理，不自动重试写请求。"
          }
        },
        "x-effect": "read",
        "x-evidence": {
          "repository": "https://github.com/1whoarei1/yanhe-refine",
          "revision": "8a292f47d7f25a697d01c9bd7c69189ce2edbf5a",
          "file": "src/lexue-core.js",
          "anchor": "/pluginfile",
          "level": "source"
        },
        "x-response-fields": "文件；由浏览器下载 API 接收，不拼接猜测文件路径"
      }
    }
